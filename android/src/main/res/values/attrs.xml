<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="ripple_relativeLayout">
        <attr name="ripple_color" format="color" />
        <attr name="ripple_radius" format="dimension"/>
        <attr name="ripple_duration" format="integer"/>
        <attr name="ripple_amount" format="integer"/>
        <attr name="ripple_scale" format="float"/>
    </declare-styleable>

    <declare-styleable name="CircularImageView">
        <attr name="border" format="boolean" />
        <attr name="border_width" format="dimension" />
        <attr name="border_color" format="color" />
        <attr name="shadow" format="boolean" />
        <attr name="is_circle" format="boolean" />
    </declare-styleable>

    <declare-styleable name="RippleBackgroundView">
        <attr name="rb_color" format="color" />
        <attr name="rb_strokeWidth" format="dimension" />
        <attr name="rb_radius" format="dimension" />
        <attr name="rb_duration" format="integer" />
        <attr name="rb_rippleAmount" format="integer" />
        <attr name="rb_scale" format="float" />
        <attr name="rb_type" format="enum">
            <enum name="fillRipple" value="0" />
            <enum name="strokeRipple" value="1" />
        </attr>
    </declare-styleable>
</resources>